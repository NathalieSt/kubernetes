    "vault_kv_secret_v2": {
      "authelia_authelia_secrets": {
        "mount": "kvv2",
        "name": "authelia/secrets",
        "cas": 0,
        "disable_read": true,
        "data_json": "{\"session-secret\":\"REPLACE ME — vault kv patch kvv2/authelia/secrets session-secret=<value>\",\"storage-encryption-key\":\"REPLACE ME — vault kv patch kvv2/authelia/secrets storage-encryption-key=<value>\",\"reset-password-jwt-secret\":\"REPLACE ME — vault kv patch kvv2/authelia/secrets reset-password-jwt-secret=<value>\",\"oidc-hmac-secret\":\"REPLACE ME — vault kv patch kvv2/authelia/secrets oidc-hmac-secret=<value>\",\"oidc-issuer-private-key\":\"REPLACE ME — vault kv patch kvv2/authelia/secrets oidc-issuer-private-key=<value>\"}",
        "custom_metadata": {
          "data": {
            "managed-by": "opentofu",
            "created-as": "placeholder",
            "owner": "authelia"
          }
        },
        "lifecycle": {
          "ignore_changes": [
            "data_json"
          ],
          "prevent_destroy": true
        }
      },
      "authelia_authelia_users": {
