{
  "resource": {
    "vault_policy": {
      "mail": {
        "name": "mail",
        "policy": "path \"kvv2/data/mail\" {\n  capabilities = [\"read\"]\n}\n\npath \"kvv2/metadata/mail\" {\n  capabilities = [\"read\"]\n}\n"
      },
      "psono-server": {
        "name": "psono-server",
        "policy": "path \"kvv2/data/psono\" {\n  capabilities = [\"read\"]\n}\n\npath \"kvv2/metadata/psono\" {\n  capabilities = [\"read\"]\n}\n"
      }
    },
    "vault_kubernetes_auth_backend_role": {
      "mail": {
        "backend": "kubernetes",
        "role_name": "mail",
        "bound_service_account_names": [
          "mail-vault-serviceaccount"
        ],
        "bound_service_account_namespaces": [
          "mail"
        ],
        "audience": "vault",
        "token_policies": [
          "${vault_policy.mail.name}"
        ],
        "token_ttl": 600
      },
      "psono-server": {
        "backend": "kubernetes",
        "role_name": "psono-server",
        "bound_service_account_names": [
          "psono-server-vault-serviceaccount"
        ],
        "bound_service_account_namespaces": [
          "psono"
        ],
        "audience": "vault",
        "token_policies": [
          "${vault_policy.psono-server.name}"
        ],
        "token_ttl": 600
      }
    },
    "vault_kv_secret_v2": {
      "mail_mail": {
        "mount": "kvv2",
        "name": "mail",
        "cas": 0,
        "disable_read": true,
        "data_json": "{\"postfix-accounts.cf\":\"REPLACE ME — vault kv patch kvv2/mail postfix-accounts.cf=<value>\"}",
        "custom_metadata": {
          "data": {
            "managed-by": "opentofu",
            "created-as": "placeholder",
            "owner": "mail"
          }
        },
        "lifecycle": {
          "ignore_changes": [
            "data_json"
          ],
          "prevent_destroy": true
        }
      },
      "psono-server_psono": {
        "mount": "kvv2",
        "name": "psono",
        "cas": 0,
        "disable_read": true,
        "data_json": "{\"secret-key\":\"REPLACE ME — vault kv patch kvv2/psono secret-key=<value>\",\"activation-link-secret\":\"REPLACE ME — vault kv patch kvv2/psono activation-link-secret=<value>\",\"db-secret\":\"REPLACE ME — vault kv patch kvv2/psono db-secret=<value>\",\"email-secret-salt\":\"REPLACE ME — vault kv patch kvv2/psono email-secret-salt=<value>\",\"private-key\":\"REPLACE ME — vault kv patch kvv2/psono private-key=<value>\",\"public-key\":\"REPLACE ME — vault kv patch kvv2/psono public-key=<value>\"}",
        "custom_metadata": {
          "data": {
            "managed-by": "opentofu",
            "created-as": "placeholder",
            "owner": "psono-server"
          }
        },
        "lifecycle": {
          "ignore_changes": [
            "data_json"
          ],
          "prevent_destroy": true
        }
      }
    }
  }
}
